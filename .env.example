# Скопируйте в .env (файл в .gitignore) и заполните своими значениями.
# Нужны ТОЛЬКО для npm run import:games — в браузер и в собранный сайт этот ключ
# не попадает.
#
# URL — тот же адрес, что url в supabase-config.js.
SUPABASE_URL=https://your-project.supabase.co
# Project Settings → API Keys → Secret keys (старое имя: service_role). НЕ publishable/anon.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key
